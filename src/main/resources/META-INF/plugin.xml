<idea-plugin>
    <id>name.admitriev.jhelper</id>
    <name>JHelper</name>
    <version>_patched_</version>
    <vendor url="https://github.com/AlexeyDmitriev/JHelper">JHelper</vendor>

    <description>Competitive programming tool to inline library code and provide testing framework.</description>

    <change-notes>
        Support CLion 2026.2 and the Nova C++ engine
    </change-notes>

    <idea-version since-build="262"/>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.clion</depends>
    <depends>com.intellij.modules.cmake</depends>
    <depends>com.intellij.modules.lang</depends>


    <extensions defaultExtensionNs="com.intellij">
        <configurationType implementation="name.admitriev.jhelper.configuration.TaskConfigurationType"/>
        <programRunner implementation="name.admitriev.jhelper.configuration.TaskRunner"/>
        <executionTargetProvider implementation="name.admitriev.jhelper.configuration.TaskConfigurationTargetProvider"/>
        <notificationGroup id="JHelper" displayType="BALLOON"/>
        <postStartupActivity implementation="name.admitriev.jhelper.components.ChromeParserStartup"/>
    </extensions>

    <projectListeners>
        <listener class="name.admitriev.jhelper.components.AutoSwitcher"
                  topic="com.intellij.execution.RunManagerListener" />
        <listener class="name.admitriev.jhelper.components.AutoSwitcher"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener" />
    </projectListeners>

    <actions>
        <!--
          The actions are declared once here, then placed twice below: flat on the main toolbar so each
          one is a single click, and nested under Tools | JHelper so the menu stays tidy.
        -->
        <action
                id="name.admitriev.jhelper.actions.configureAction"
                class="name.admitriev.jhelper.actions.ConfigureAction"
                text="Configure"
                description="Configure JHelper"
                icon="/name/admitriev/jhelper/icons/settings.png"
        />
        <action
                id="name.admitriev.jhelper.actions.AddTaskAction"
                class="name.admitriev.jhelper.actions.AddTaskAction"
                text="Add Task"
                description="Creates new task."
                icon="/name/admitriev/jhelper/icons/newTask.png"
        />
        <action
                id="name.admitriev.jhelper.actions.EditTestsAction"
                class="name.admitriev.jhelper.actions.EditTestsAction"
                text="Edit tests"
                description="Edit tests for a current task"
                icon="/name/admitriev/jhelper/icons/editTests.png"
        />
        <action
                id="name.admitriev.jhelper.actions.CopySourceAction"
                class="name.admitriev.jhelper.actions.CopySourceAction"
                text="Copy source"
                description="Copies source of output file"
                icon="/name/admitriev/jhelper/icons/copy.png"
        />
        <action
                id="name.admitriev.jhelper.actions.ParseContestAction"
                class="name.admitriev.jhelper.actions.ParseContestAction"
                text="Parse contest"
                description="Creates a task for each problem in a contest"
                icon="/name/admitriev/jhelper/icons/parseContest.png"
        />
        <action
                id="name.admitriev.jhelper.actions.DeleteTaskAction"
                class="name.admitriev.jhelper.actions.DeleteTaskAction"
                text="Delete task"
                description="Deletes selected configuration, its task file and class file"
                icon="/name/admitriev/jhelper/icons/delete.png"
        />
        <action
                id="name.admitriev.jhelper.actions.ProcessAction"
                class="name.admitriev.jhelper.actions.ProcessAction"
                text="Process file"
                description="Inlines includes from the current file"
                icon="/name/admitriev/jhelper/icons/task.png"
        />

        <!--
          Toolbar placement. popup="false" inlines the children, so each action is its own button rather
          than a dropdown that has to be opened first. The new UI keeps the run configuration widget and
          the run/debug buttons in MainToolbarRight; MainToolBar is the classic UI equivalent and is
          ignored when the new UI is active.
        -->
        <group id="name.admitriev.jhelper.JHelperToolbarGroup" text="JHelper" popup="false">
            <!--
              MainToolbarRight holds, in order, the run widget and run/debug buttons, then
              SearchEverywhere and SettingsEntryPoint. Anchoring first landed the group left of the run
              widget, so anchor before SearchEverywhere instead: that is immediately right of the
              run/debug buttons and still left of the search and settings icons.
            -->
            <add-to-group group-id="MainToolbarRight" anchor="before" relative-to-action="SearchEverywhere"/>
            <add-to-group group-id="MainToolBar" anchor="last"/>

            <reference ref="name.admitriev.jhelper.actions.AddTaskAction"/>
            <reference ref="name.admitriev.jhelper.actions.ParseContestAction"/>
            <reference ref="name.admitriev.jhelper.actions.ProcessAction"/>
            <reference ref="name.admitriev.jhelper.actions.CopySourceAction"/>
            <reference ref="name.admitriev.jhelper.actions.EditTestsAction"/>
            <reference ref="name.admitriev.jhelper.actions.DeleteTaskAction"/>
            <reference ref="name.admitriev.jhelper.actions.configureAction"/>
            <separator/>
        </group>

        <!-- Menu placement, kept as a submenu so seven entries don't flood the Tools menu. -->
        <group
                id="name.admitriev.jhelper.JHelperGroup"
                text="JHelper"
                description="JHelper actions"
                popup="true"
                icon="/name/admitriev/jhelper/icons/task.png"
        >
            <add-to-group group-id="ToolsMenu" anchor="last"/>

            <reference ref="name.admitriev.jhelper.actions.AddTaskAction"/>
            <reference ref="name.admitriev.jhelper.actions.ParseContestAction"/>
            <reference ref="name.admitriev.jhelper.actions.ProcessAction"/>
            <reference ref="name.admitriev.jhelper.actions.CopySourceAction"/>
            <reference ref="name.admitriev.jhelper.actions.EditTestsAction"/>
            <reference ref="name.admitriev.jhelper.actions.DeleteTaskAction"/>
            <reference ref="name.admitriev.jhelper.actions.configureAction"/>
        </group>
    </actions>
</idea-plugin>
